{
  "name": "verinode-backend",
  "version": "1.0.0",
  "description": "Verinode backend API for cryptographic proof verification",
  "main": "src/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .ts,.js",
    "lint:fix": "eslint src/ --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "python:install": "pip install -r requirements.txt",
    "python:setup": "python -m spacy download en_core_web_sm"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "cids": "^1.1.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "ipfs-core": "^0.18.0",
    "ipfs-http-client": "^60.0.1",
    "ipfs-pubsub-room": "^3.0.0",
    "it-all": "^3.0.4",
    "it-buffer": "^0.1.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.1.1",
    "multihashes": "^4.0.3",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "sharp": "^0.33.5",
    "twilio": "^6.0.2",
    "uint8arrays": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "stellar",
    "api",
    "blockchain",
    "verification",
    "proofs",
    "web3",
    "ipfs",
    "decentralized-storage"
  ],
  "author": "Verinode Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": "tsconfig.test.json",
        "diagnostics": false
      }]
    },
    "moduleNameMapper": {
      "^ioredis$": "<rootDir>/src/__mocks__/ioredis.js",
      "^express$": "<rootDir>/src/__mocks__/express.js"
    }
  }
}
